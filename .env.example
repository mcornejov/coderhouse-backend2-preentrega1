# Puerto donde escucha el servidor HTTP
PORT=8080

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cadena de conexión a MongoDB (Atlas o local). Opcional en esta etapa: si queda
# vacía, el servidor arranca sin base de datos. Formato de ejemplo:
# mongodb+srv://usuario:password@cluster.mongodb.net/cafe_aurora_eventos?appName=Cluster
MONGO_URL=

# Secreto para firmar los JSON Web Tokens (autenticación de próximas entregas)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
